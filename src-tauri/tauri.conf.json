{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TY Music",
  "version": "1.0.3",
  "identifier": "com.tymusic.desktop",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "http://localhost:8899"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TY Music",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "public.app-category.music",
    "shortDescription": "TY Music desktop music player",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
